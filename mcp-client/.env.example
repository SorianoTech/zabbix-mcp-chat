# Copia este fichero a .env y ajusta los valores. .env no debe versionarse.

# --- LLM (cualquier proveedor soportado por LangChain) ---
# LLM_PROVIDER: openai | anthropic | ollama | google_genai | azure_openai | mistralai | groq |
#               bedrock_converse | ... (instala el paquete langchain-<proveedor>, ver requirements.txt)
# Ejemplos:
#   OpenAI:        LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini        (LLM_API_KEY u OPENAI_API_KEY)
#   Anthropic:     LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5-5  (LLM_API_KEY o ANTHROPIC_API_KEY)
#   Ollama nativo: LLM_PROVIDER=ollama     LLM_MODEL=qwen2.5:14b        LLM_BASE_URL=http://localhost:11434
#   Compatible OpenAI (vLLM, LM Studio, LiteLLM...): LLM_PROVIDER=openai  LLM_BASE_URL=http://host:puerto/v1
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
# Vacíos = cada proveedor usa sus variables de entorno propias
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
# Vacía = la del modelo por defecto (recomendado). Algunos modelos, como claude-sonnet-5-5,
# rechazan cualquier valor distinto del suyo. Para modelos que lo admiten, 0.1 da respuestas más estables.
LLM_TEMPERATURE=
# Máximo de tokens que puede generar el LLM por respuesta (vacío = valor por defecto del proveedor)
LLM_MAX_TOKENS=
# Opciones propias del proveedor, en JSON (p. ej. Ollama: {"num_ctx": 16384})
LLM_KWARGS=

# --- Credencial de Zabbix del usuario (solo cliente.py en consola) ---
# Tu token de API personal de Zabbix (Configuración de usuario → Tokens de API). Si se define,
# las herramientas consultan Zabbix con TUS permisos (el servidor MCP necesita
# delegated_auth = "allowed" o "required"). Vacío = credencial de servicio del servidor MCP.
# La pasarela no la usa: allí la credencial es la sesión de cada usuario del frontend.
ZABBIX_USER_TOKEN=

# --- Servidor MCP de Zabbix ---
# "http": servidor ya arrancado (zabbix-mcp-server --config config.toml --transport http)
# "stdio": el cliente lanza el servidor como subproceso
MCP_TRANSPORT=http
MCP_URL=http://127.0.0.1:8080/mcp
# Token Bearer del servidor MCP (auth_token o token creado en el portal admin). Vacío = sin auth.
MCP_TOKEN=
# Solo para stdio: comando completo para lanzar el servidor
MCP_STDIO_COMMAND=zabbix-mcp-server --config ../zabbix-mcp-server/config.toml --transport stdio

# --- Reducción de tokens ---
# Herramientas que se envían al LLM: lista separada por comas, admite comodines (*).
# Vacío = TODAS (más de 200 herramientas, unos 100k tokens por petición: no recomendado).
TOOLS_ALLOW=problem_active_get,host_status_get,hostgroup_overview_get,infrastructure_summary_get,item_history_summary_get,host_get,item_get,trigger_get,event_get
# Herramientas a excluir aunque coincidan con TOOLS_ALLOW
TOOLS_DENY=
# Recorta la descripción de cada herramienta a N caracteres (0 = sin recorte)
TOOL_DESC_MAX_CHARS=300
# Recorta la descripción de cada parámetro a N caracteres (0 = sin recorte)
PARAM_DESC_MAX_CHARS=120
# Quita del esquema de parámetros los opcionales cuyo nombre aparece aquí (p. ej. raw_json,server)
DROP_PARAMS=raw_json
# Recorta la respuesta de cada herramienta a N caracteres antes de enviarla al LLM (0 = sin recorte)
TOOL_RESULT_MAX_CHARS=6000
# Recorta a N caracteres los resultados de herramientas de preguntas ANTERIORES (0 = sin recorte)
HISTORY_TOOL_RESULT_MAX_CHARS=800
# Turnos de usuario anteriores que se conservan en el historial (0 = sin límite)
HISTORY_MAX_TURNS=4
# Añade al prompt de sistema las instrucciones que publica el servidor MCP (~500 tokens)
INCLUDE_SERVER_INSTRUCTIONS=true
# Llamadas a herramientas encadenadas como máximo por pregunta
MAX_TOOL_ROUNDS=8

# --- Pasarela para el módulo de chat de Zabbix (pasarela.py) ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8770
# Clave compartida con el módulo de Zabbix (genera una larga y aleatoria). Vacía = sin autenticación.
GATEWAY_API_KEY=
# Minutos sin actividad tras los que se olvida una conversación
GATEWAY_IDLE_MINUTES=60
GATEWAY_MAX_CONVERSATIONS=200
GATEWAY_MAX_MESSAGE_CHARS=4000

# --- Logging ---
# DEBUG muestra en consola los mensajes y llamadas; INFO solo el resumen
LOG_LEVEL=INFO
LOG_DIR=logs
# true = guarda cada petición completa enviada al LLM en logs/llm_requests.jsonl
LOG_LLM_PAYLOADS=false

# --- Observabilidad de la pasarela (observabilidad.py + panel.py) ---
# Guarda cada pregunta (usuario, pregunta, respuesta, tokens y llamadas a herramientas con sus
# argumentos y resultados) en SQLite. Contiene datos de Zabbix: protege el fichero.
# La credencial de Zabbix del usuario NUNCA se guarda.
OBS_ENABLED=true
OBS_DB=logs/observabilidad.db
# Recorta cada resultado de herramienta guardado a N caracteres (0 = sin recorte)
OBS_TOOL_RESULT_MAX_CHARS=20000
# Días que se conservan los datos (0 = siempre)
OBS_RETENTION_DAYS=90
# Panel (streamlit run panel.py). Contraseña vacía = sin contraseña (escucha en localhost)
PANEL_PASSWORD=
# Precios por millón de tokens para estimar el coste (vacíos = no se muestra coste)
PANEL_PRICE_INPUT_PER_MTOK=
PANEL_PRICE_OUTPUT_PER_MTOK=
PANEL_PRICE_CACHED_PER_MTOK=
# Phoenix (opcional, pip install -r requirements-phoenix.txt): trazas OpenTelemetry de LangChain
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT=zabbix-chat
# URL de la UI de Phoenix para el enlace del panel (vacía = PHOENIX_COLLECTOR_ENDPOINT)
PANEL_PHOENIX_URL=
